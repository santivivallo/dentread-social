# ---- Meta / Instagram ----------------------------------------------------
# App "DentRead Social Publisher" creada 2026-08-09
#   Caso de uso: "Administrar mensajes y contenido en Instagram"
#   Vía "API con inicio de sesión con Facebook" — NO la de Instagram Login,
#   que usa otro App ID y los permisos instagram_business_*. Nuestro código
#   habla con graph.facebook.com contra el IG_USER_ID de abajo.
#   Permisos concedidos: instagram_basic, instagram_content_publish,
#   pages_show_list, pages_read_engagement, business_management
META_APP_ID=1702371920994712
# Configuración de la app → Básica → Mostrar
META_APP_SECRET=
# lo escribe tools/exchange_meta_token.py
META_ACCESS_TOKEN=
# Pegá acá el token corto del Explorador y corré:
#   python -m tools.exchange_meta_token
# Canjea por uno de ~60 días, verifica que resuelva @dentread_, lo guarda
# en META_ACCESS_TOKEN y borra esta línea. No imprime el token.
META_SHORT_TOKEN=
# Verificado el 2026-08-09 en Meta Business Suite:
#   cuenta @dentread_  ·  Business ("Empresa de software")
#   vinculada a la Página de Facebook "DentRead APP"
#   portfolio comercial "DentRead | AI powered Dentistry"
# OJO: @dentread (sin guion bajo) NO es de DentRead. Ver GO-LIVE.md §0.
IG_USER_ID=17841434843464885

# ---- LinkedIn ------------------------------------------------------------
# App "DentRead Social Publisher" creada 2026-08-09
#   App ID 263015564 · página DentRead verificada el 2026-08-09
#   Community Management API (Development Tier) solicitada el 2026-08-09
#   Entidad declarada: DentRead AI Corp. (Delaware C-Corp)
#   Alt: Humano Corporation · casos de uso: page management + page analytics
LINKEDIN_CLIENT_ID=77oujwc4moeijk
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# Verificado el 2026-08-09 en el admin de la página: DentRead = 102793096
LINKEDIN_ORG_URN=urn:li:organization:102793096

# ---- Bucket S3-compatible (staging de imágenes para Instagram) -----------
# Cloudflare R2 recomendado: sin egress fee.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=dentread-social
S3_REGION=auto
# dominio público del bucket
S3_PUBLIC_BASE=https://media.dentread.app
# OJO: .app, no .com. dentread.com es de otra empresa (ver GO-LIVE.md §0).

# ---- Interno -------------------------------------------------------------
# El store va cifrado con Fernet: la extensión .enc evita que alguien lo abra
# esperando JSON legible. Ambos nombres están en .gitignore.
TOKEN_STORE=.tokens.enc
# Cifra el store en reposo. Generar una vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_STORE_KEY=
